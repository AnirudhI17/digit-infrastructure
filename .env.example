# ==============================================================================
# DIGIT INFRASTRUCTURE ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local environment.
# Do not commit the actual .env file with production credentials to Git.

# Global Settings
ENVIRONMENT=development
COMPOSE_PROJECT_NAME=digit-infra

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=digit_db
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# Database initialization lists (comma separated, used by init scripts)
POSTGRES_ADDITIONAL_DATABASES=egov_user,egov_localization,egov_mdms,egov_filestore,egov_pg

# ------------------------------------------------------------------------------
# Apache Kafka & Zookeeper Configuration
# ------------------------------------------------------------------------------
ZOOKEEPER_PORT=2181
ZOOKEEPER_TICK_TIME=2000

KAFKA_PORT=9092
KAFKA_ADVERTISED_PORT=9092
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=1073741824

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ------------------------------------------------------------------------------
# Elasticsearch Configuration
# ------------------------------------------------------------------------------
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTIC_PASSWORD=changeme
# JVM options
ES_JAVA_OPTS=-Xms512m -Xmx512m
